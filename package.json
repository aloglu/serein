{
  "name": "serein",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown-first static daily poem publisher",
  "bin": {
    "serein": "./scripts/serein.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "poems:sync": "node scripts/normalize-poems.mjs",
    "normalize:poems": "node scripts/normalize-poems.mjs",
    "editorial:report": "node scripts/editorial-report.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:asof": "node scripts/preview.mjs --watch"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "marked": "^17.0.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "ttf2woff2": "^8.0.1"
  },
  "overrides": {
    "node-gyp": "^12.2.0",
    "tar": "^7.5.22",
    "serve": {
      "compression": "^1.8.2"
    }
  }
}
